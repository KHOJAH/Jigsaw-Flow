{
  "name": "jigsaw-flow",
  "version": "1.0.3",
  "type": "module",
  "description": "Professional Desktop Jigsaw Puzzle Studio",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite",
    "build:assets": "node scripts/generate-installer-assets.mjs",
    "dist": "npm run build && npm run build:assets && electron-builder --win",
    "dist:dir": "npm run build && npm run build:assets && electron-builder --win --dir"
  },
  "keywords": [
    "jigsaw",
    "puzzle",
    "electron",
    "react",
    "canvas"
  ],
  "author": "Jigsaw Flow",
  "license": "MIT",
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}